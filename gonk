#!/usr/bin/env bash
#
# Served at https://marclevin.me/gonk
#
#   curl -fsSL https://marclevin.me/gonk | bash
#
# This file never needs to change. It fetches the real installer from the
# GonkLander repository and runs it. It contains no credentials.
#
# To pin what gets installed:   curl -fsSL https://marclevin.me/gonk | GONK_VERSION=v0.1.0 bash

set -euo pipefail

gonk_shim() {
    local repo="${GONK_REPO:-marclevin/GonkLander}"
    local version="${GONK_VERSION:-main}"
    local url="https://raw.githubusercontent.com/${repo}/${version}/lander/install.sh"
    local installer

    if command -v curl >/dev/null 2>&1; then
        installer="$(curl -fsSL "$url")"
    elif command -v wget >/dev/null 2>&1; then
        installer="$(wget -qO- "$url")"
    else
        echo "Gonk needs curl or wget to download itself, and found neither." >&2
        exit 1
    fi || {
        echo "Could not download the Gonk installer from:" >&2
        echo "    ${url}" >&2
        echo "Check this machine's Internet connection, and that version '${version}' exists." >&2
        exit 1
    }

    GONK_REPO="$repo" GONK_VERSION="$version" bash -c "$installer"
}

gonk_shim
